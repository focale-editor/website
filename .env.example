# Public identifier of the Loops.so newsletter form that collects alpha signups.
# Found in Loops under Forms > (your form) > Embed / API, in the endpoint URL
# https://app.loops.so/api/newsletter-form/<FORM_ID>
# It is a public value: it is embedded in the generated pages by design.
NUXT_PUBLIC_LOOPS_FORM_ID=

# Optional overrides.
# NUXT_PUBLIC_REPOSITORY_URL=https://github.com/focale-editor/website
# NUXT_PUBLIC_APP_REPOSITORY_URL=https://github.com/focale-editor/focale
