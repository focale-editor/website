    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.1",
    "@openvue/nuxt-module": "1.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
